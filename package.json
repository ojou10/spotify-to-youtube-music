{
  "name": "playlist-bridge",
  "private": true,
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --reload --host 127.0.0.1 --port 8765",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "python -m pytest backend/tests -q",
    "test:frontend": "npm --prefix frontend test -- --run",
    "lint": "npm run lint:frontend && python -m ruff check backend",
    "lint:frontend": "npm --prefix frontend run lint",
    "build": "npm --prefix frontend run build"
  }
}
